# ──────────────────────────────────────────────────────────
# Dental RAG Chatbot — Environment Variables
# Copy file này thành .env và điền giá trị thực tế.
# ──────────────────────────────────────────────────────────

# === EMBEDDING ENGINE (Vector Search) ===
# "local"  → sentence-transformers vietnamese-sbert (miễn phí)
# "openai" → API text-embedding-3-small (trả phí)
EMBEDDING_ENGINE=local

# === LLM ENGINE (Chat / Query Rewrite) ===
# "openai" → API gpt-4o-mini (trả phí)
# "local"  → Ollama localhost qwen2.5:7b (miễn phí, cần cài Ollama)
LLM_ENGINE=openai

# === OpenAI ===
OPENAI_API_KEY=sk-...
OPENAI_CHAT_MODEL=gpt-4o-mini

# === Ollama (chỉ cần nếu LLM_ENGINE=local) ===
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_CHAT_MODEL=qwen2.5:7b

# === Database ===
DATABASE_URL=mysql+pymysql://user:password@localhost:3306/dental_db

# === JWT ===
SECRET_KEY=your-secret-key-here
