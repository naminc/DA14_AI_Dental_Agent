# This file is used to set environment variables for the application. It should not be committed to version control if it contains sensitive information.

# ---------------------------------------------------------------------------
# Multi-Embedding Engine
#   EMBEDDING_ENGINE = "local"   → sentence-transformers (miễn phí, offline)
#   EMBEDDING_ENGINE = "openai"  → API text-embedding-3-small (trả phí)
# ---------------------------------------------------------------------------
EMBEDDING_ENGINE=openai

# ---------------------------------------------------------------------------
# Multi-LLM Engine
#   LLM_ENGINE = "openai"   → API GPT-4.1-mini (trả phí)
#   LLM_ENGINE = "local"    → Ollama localhost (qwen2.5:1.5b) (miễn phí, offline)
# ---------------------------------------------------------------------------
LLM_ENGINE=openai

# OpenAI API Key
OPENAI_API_KEY=sk-proj-
OPENAI_CHAT_MODEL=gpt-4.1-mini

# === Ollama (chỉ cần nếu LLM_ENGINE=local) ===
OLLAMA_BASE_URL=http://localhost:11434/v1
# Model hiện tại đang dùng trong hệ thống (quantized 4-bit, ~1GB VRAM)
OLLAMA_CHAT_MODEL=qwen2.5:1.5b-instruct-q4_K_M

# ---------------------------------------------------------------------------
# Retrieval
#   TOP_K = số tài liệu cuối cùng đưa vào ngữ cảnh cho LLM (mặc định 10)
# ---------------------------------------------------------------------------
TOP_K=10

# Database Configuration
DATABASE_URL=mysql+pymysql://root@localhost:3306/dental_agent_db

# JWT Configuration
# Sinh khóa bí mật bằng:  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=1440
ALGORITHM=HS256

# Upgrade Dataset Model (dùng cho tools/upgrade_dataset.py)
UPGRADE_DATASET_MODEL=gpt-4o-mini